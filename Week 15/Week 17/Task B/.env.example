# Track B Configuration — copy to .env and fill in real values
# NEVER commit .env with real API keys

# Groq API keys (rotate through 5 keys for rate-limit management)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_ACTIVE_KEY=1
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (fallback provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# LLM settings
LLM_PROVIDER=groq
TEMPERATURE=0.7
MAX_TOKENS=1024
AGENTIC_MAX_ITERATIONS=5
