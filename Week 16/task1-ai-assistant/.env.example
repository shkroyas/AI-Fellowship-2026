# ── LLM Provider Configuration ──
# Primary provider: gemini, openai, or local_vllm
LLM_PROVIDER=gemini

# Google Gemini (set your API key here)
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=
# Select a configured key (1-based); 429 never rotates credentials.
GEMINI_ACTIVE_KEY=1
GEMINI_MODEL=gemini-3.6-flash

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local vLLM (optional)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=unsloth/gemma-2b-it

# ── Generation Parameters ──
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048

# ── RAG Configuration ──
CHROMA_PERSIST_DIR=./data/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3

DEBUG=false
