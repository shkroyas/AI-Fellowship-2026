# ── LLM Provider Configuration ──
# Primary provider: groq, openrouter, or openai
LLM_PROVIDER=groq

# Groq (primary - up to 5 keys for rotation)
GROQ_API_KEY=your-groq-api-key-1
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# Select a configured key (1-based); 429 never rotates credentials.
GROQ_ACTIVE_KEY=1
GROQ_MODEL=openai/gpt-oss-20b
# Shared organization allowance (8000 tokens/min per org, not per key).
GROQ_TOKENS_PER_MINUTE=8000

# OpenRouter (fallback - free tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# OpenAI (optional secondary fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Generation Parameters ──
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=1024

# ── RAG Configuration ──
CHROMA_PERSIST_DIR=./data/chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
